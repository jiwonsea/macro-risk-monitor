# Normalize line endings to LF on commit; prevents CRLF churn across OSes.
* text=auto eol=lf

# Explicit text types (belt-and-suspenders)
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.j2    text eol=lf
*.txt   text eol=lf

# Binary — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.ico   binary
