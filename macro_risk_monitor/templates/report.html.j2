{% extends "_base.html.j2" %}
{% block body %}

<h1>
  {{ report.risk.title }}
  <small>{{ report.risk.name }} · {{ report.generated_at.strftime("%Y-%m-%d %H:%M") }}</small>
</h1>

{% if report.as_of %}
<p style="background: #fef3c7; border: 1px solid #d97706; border-radius: 4px; padding: 6pt 8pt; font-size: 9.5pt;">
  ⏳ <strong>{{ report.as_of.isoformat() }}</strong> 시점 재현 리포트 (<code>run --as-of</code>) —
  재현 불가 소스는 UNKNOWN 처리, 상태 스냅샷/히스토리는 갱신되지 않음.
</p>
{% endif %}

<div class="exec-card">
  <span class="action {{ report.decision.action }}">{{ report.decision.action.replace("_", " ").upper() }}</span>
  <p style="margin: 8pt 0 0 0;">{{ report.decision.summary }}</p>
  {% if report.decision.red_categories %}
  <p style="margin: 4pt 0 0 0; font-size: 9.5pt; color: #4a5568;">
    RED categories: {{ report.decision.red_categories|map(attribute="value")|join(", ") }}
  </p>
  {% endif %}
</div>

{% if state_diff %}
<h2>변경 사항 (이전 실행 대비)</h2>
<ul class="diff-list">
  {% for trigger_id, old, new in state_diff %}
  <li><strong>{{ trigger_id }}</strong>
    <span class="status-cell status-{{ old.value }}">{{ old.value }}</span>
    <span class="diff-arrow">→</span>
    <span class="status-cell status-{{ new.value }}">{{ new.value }}</span>
  </li>
  {% endfor %}
</ul>
{% endif %}

<h2>가설</h2>
<p>{{ report.risk.hypothesis | replace("\n", " ") }}</p>

<h2>트리거 상태표</h2>
{{ trigger_table_html | safe }}

{% if chart_section %}
<h2>차트</h2>
{{ chart_section | safe }}
{% endif %}

<h2>분석 (LLM)</h2>
<div class="llm-analysis">
{{ analysis_html | safe }}
</div>

{% if report.risk.critical_windows %}
<h2>Critical windows</h2>
<table>
  <thead>
    <tr><th>Date</th><th>Event</th><th>Rationale</th></tr>
  </thead>
  <tbody>
  {% for w in report.risk.critical_windows %}
  <tr>
    <td>{{ w.date.isoformat() }}</td>
    <td><strong>{{ w.event }}</strong></td>
    <td>{{ w.rationale or "" }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

<footer>
  <p>
    LLM: <strong>{{ report.llm_model }}</strong> ·
    Citation check:
    {% if report.citation_check.passed %}
      <span class="citation-ok">PASS</span>
      ({{ report.citation_check.grounded_count }} grounded references)
    {% else %}
      <span class="citation-fail">FAIL</span>
      ({{ report.citation_check.ungrounded|length }} ungrounded:
      {{ report.citation_check.ungrounded|join(", ") }})
    {% endif %}
  </p>
  <p>Generated by macro-risk-monitor at {{ report.generated_at.isoformat() }}.
     본 리포트는 자동화 산출물이며 투자 권유 자료가 아닙니다.</p>
</footer>

{% endblock %}
