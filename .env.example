# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# FRED API (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# SEC EDGAR — User-Agent required (any descriptive string with email)
SEC_USER_AGENT=macro-risk-monitor your-email@example.com

# Model selection (default: claude-sonnet-4-6)
MACRO_RISK_LLM_MODEL=claude-sonnet-4-6

# Chrome executable for HTML→PDF rendering (Windows default path)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
